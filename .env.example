# Application
# 运行环境：development、test 或 production
APP_ENV=development
# 应用监听地址
APP_HOST=127.0.0.1
# 应用监听端口
APP_PORT=8000
# 应用日志级别
APP_LOG_LEVEL=INFO
# 应用版本号
APP_VERSION=0.1.0

# PostgreSQL (local Docker Compose default)
# PostgreSQL 主机地址
POSTGRES_HOST=127.0.0.1
# PostgreSQL 数据库名称
POSTGRES_DB=mem_ai
# PostgreSQL 用户名
POSTGRES_USER=mem_ai
# PostgreSQL 用户密码
POSTGRES_PASSWORD=change-this-local-password
# PostgreSQL 端口
POSTGRES_PORT=5432
# Optional host bind-mount path for Docker Compose PostgreSQL data;
# leave unset to use the default named volume `postgres_data`.
# Docker Compose 的 PostgreSQL 数据宿主机目录；未设置时使用默认命名卷
# POSTGRES_DATA_DIR=/path/to/postgres-data

# Database pool and timeouts
# 数据库连接池常驻连接数
DB_POOL_SIZE=5
# 连接池允许额外创建的最大连接数
DB_MAX_OVERFLOW=5
# 等待连接池可用连接的超时时间（秒）
DB_POOL_TIMEOUT_SECONDS=10.0
# 建立数据库连接的超时时间（秒）
DB_CONNECT_TIMEOUT_SECONDS=5.0
# 数据库语句执行超时时间（毫秒）
DB_STATEMENT_TIMEOUT_MS=10000
# 数据库健康检查超时时间（秒）
DB_HEALTH_CHECK_TIMEOUT_SECONDS=2.0
# Optional compatible Alembic revisions accepted during rolling upgrades
# 滚动升级期间允许的兼容 Alembic 版本列表（JSON 数组）
# COMPATIBLE_ALEMBIC_REVISIONS=["20261126_0013"]

# Security, Host/CORS allowlists, and process resource budgets
# 允许跨域访问的来源列表（JSON 数组）
# CORS_ALLOWED_ORIGINS=["https://app.example.com"]
# Production requires explicit non-wildcard ALLOWED_HOSTS (e.g. ["api.example.com"]).
# 允许访问应用的主机名列表（JSON 数组）；生产环境须显式配置且不能使用通配符
# ALLOWED_HOSTS=["api.example.com"]
# 用于读取请求 ID 的请求头名称
TRUSTED_REQUEST_ID_HEADER=X-Request-Id
# Defaults to true in production, false in development/test.
# 是否仅信任来自受信代理的请求 ID；默认生产环境开启、开发和测试环境关闭
# TRUST_REQUEST_ID_FROM_PROXIES_ONLY=true
# 请求体大小上限（字节）
MAX_REQUEST_BODY_BYTES=1048576
# 进程内并发请求数上限
MAX_CONCURRENT_REQUESTS=100
# 进程内并发生成数上限
MAX_CONCURRENT_GENERATIONS=20
# 限流响应建议客户端等待的时间（秒）
RATE_LIMIT_RETRY_AFTER_SECONDS=5
# 代理读取超时预算（秒），须大于流式心跳间隔
PROXY_READ_TIMEOUT_SECONDS=60.0

# Controlled observability and Prometheus /metrics endpoint
# 是否启用 Prometheus 指标端点
METRICS_ENABLED=true
# 允许访问指标端点的 IP 或 CIDR 列表（JSON 数组）
METRICS_ALLOWED_NETWORKS=["127.0.0.1/32","::1/128"]
# 访问指标端点的可选 Bearer 令牌；生产环境至少 32 个字符
# METRICS_BEARER_TOKEN=replace-with-at-least-32-char-metrics-token

# Outbound HTTP client timeouts
# 出站 HTTP 连接超时时间（秒）
HTTP_CONNECT_TIMEOUT_SECONDS=5.0
# 出站 HTTP 读取超时时间（秒）
HTTP_READ_TIMEOUT_SECONDS=30.0
# 出站 HTTP 写入超时时间（秒）
HTTP_WRITE_TIMEOUT_SECONDS=10.0
# 等待出站 HTTP 连接池的超时时间（秒）
HTTP_POOL_TIMEOUT_SECONDS=5.0

# Built-in authentication (email + password + JWT Access Token + persistent Refresh Token sessions)
# Production must set a unique AUTH_JWT_SECRET with at least 32 characters.
# JWT 签名密钥；生产环境必须使用至少 32 个字符的非默认密钥
# AUTH_JWT_SECRET=replace-with-at-least-32-char-jwt-secret-in-production
# JWT 时间校验允许的时钟偏差（秒）
AUTH_JWT_LEEWAY_SECONDS=30
# 访问令牌有效期（秒）
AUTH_ACCESS_TOKEN_EXPIRES_IN=3600  # Access Token 有效期（秒），默认 1 小时
# 刷新令牌有效期（秒）
AUTH_REFRESH_TOKEN_EXPIRES_IN=2592000  # Refresh Token 有效期（秒），默认 30 天
# 是否开放用户自助注册
AUTH_ALLOW_SELF_REGISTRATION=true  # 是否开放自助注册
# 过期登录会话保留天数
AUTH_SESSIONS_RETENTION_DAYS=90  # 过期登录会话保留天数
# Optional reverse-proxy IP/CIDR allowlist for trusted forwarding headers and X-Request-Id
# 允许信任转发请求头和请求 ID 的代理 IP 或 CIDR 列表（JSON 数组）
# AUTH_TRUSTED_PROXIES=["10.0.0.0/8"]

# Account deletion receipts; keep the key stable for the full receipt lifetime.
# Production should configure a separate random key with at least 32 characters.
# If absent, falls back to AUTH_JWT_SECRET.
# Rotating this key revokes outstanding receipts.
# 账户删除回执签名密钥；未设置时使用 JWT 密钥，轮换会使现有回执失效
# DELETION_RECEIPT_SECRET=replace-with-an-independent-at-least-32-char-secret
# 账户删除回执有效期（秒）
DELETION_RECEIPT_TTL_SECONDS=2592000

# Memory provider (`disabled` | `memos`)
# Keep MEMOS_API_KEY strictly server-side; never commit real keys.
# 记忆提供方模式：disabled 或 memos
MEMORY_PROVIDER_MODE=disabled
# MemOS API 基础地址
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
# MemOS API 密钥，仅供服务端使用
# MEMOS_API_KEY=replace-with-server-side-memos-api-key
# MemOS 请求超时时间（秒）
MEMOS_REQUEST_TIMEOUT_SECONDS=15.0
# MemOS 记忆列表每页请求数量
MEMOS_LIST_PAGE_SIZE=100
# 一次记忆列表读取的最大条目数
MEMOS_LIST_MAX_ITEMS=1000
# 记忆列表分页快照有效期（秒）
MEMORY_LIST_SNAPSHOT_TTL_SECONDS=600
# 清理记忆前等待在途写入收敛的最长时间（秒）
MEMORY_INFLIGHT_SETTLE_TIMEOUT=60.0
# 记忆清空后执行延迟补偿清空的等待时间（秒）
MEMORY_CLEAR_COMPENSATION_DELAY_SECONDS=30.0
# Optional independent append-only JSONL deletion audit archive path (outside DB backups)
# 独立追加式删除审计 JSONL 归档文件路径
# DELETION_AUDIT_ARCHIVE_PATH=/var/lib/mem-ai/deletion-audit.jsonl

# Model provider (`disabled` | `openai_compatible`) and chat budgets
# Keep OPENAI_COMPAT_API_KEY strictly server-side; never commit real keys.
# 模型提供方模式：disabled 或 openai_compatible
MODEL_PROVIDER_MODE=disabled
# OpenAI 兼容模型 API 基础地址
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OpenAI 兼容模型 API 密钥，仅供服务端使用
# OPENAI_COMPAT_API_KEY=replace-with-server-side-model-api-key
# 模型提供方请求超时时间（秒）
OPENAI_COMPAT_REQUEST_TIMEOUT_SECONDS=60.0
# 默认使用的模型注册 ID
# MODEL_DEFAULT_ID=gpt-4o-mini
# 服务端强制使用的模型注册 ID
# MODEL_FORCED_ID=
# 是否允许请求指定模型
MODEL_ALLOW_REQUEST_OVERRIDE=false
# 是否在启动时同步模型注册配置
MODEL_SYNC_ON_STARTUP=true
# 受控模型注册配置列表（JSON 数组）
# MODEL_REGISTRY_ENTRIES=[{"model_id":"gpt-4o-mini","provider_id":"openai_compatible","upstream_model":"gpt-4o-mini","display_name":"GPT-4o Mini","enabled":true,"supports_streaming":true}]
# 对话生成超时时间（秒）
CHAT_GENERATION_TIMEOUT_SECONDS=60.0
# 流式响应最长持续时间（秒）
CHAT_STREAM_TIMEOUT_SECONDS=120.0
# 流式响应心跳间隔（秒）
CHAT_STREAM_HEARTBEAT_INTERVAL_SECONDS=15.0
# 构造对话上下文时读取的历史消息数量上限
CHAT_HISTORY_MESSAGE_LIMIT=20
# 对话生成租约有效期（秒）
CHAT_LEASE_TTL_SECONDS=60
# 对话生成租约续期间隔（秒）
CHAT_LEASE_RENEW_INTERVAL_SECONDS=20.0
# 对话记忆召回超时时间（秒）
CHAT_MEMORY_RECALL_TIMEOUT_SECONDS=5.0
# 召回记忆的最低相关度阈值
CHAT_MEMORY_MIN_RELEVANCE=0.5
# 对话中召回的记忆条目数上限
CHAT_MEMORY_MAX_ITEMS=10
# 召回记忆上下文的字符数上限
CHAT_MEMORY_CONTEXT_MAX_CHARS=2000
# 对话提示词的字符数上限
CHAT_PROMPT_MAX_CHARS=24000
# 单条对话消息的字符数上限
CHAT_MESSAGE_MAX_CHARS=32000

# Background worker and durable job budgets
# 后台任务并发执行数
WORKER_CONCURRENCY=4
# 后台任务轮询间隔（秒）
WORKER_POLL_INTERVAL_SECONDS=1.0
# 每次领取后台任务的数量上限
WORKER_CLAIM_BATCH_SIZE=10
# 后台任务租约有效期（秒）
WORKER_LEASE_TTL_SECONDS=60
# 后台任务租约续期间隔（秒）
WORKER_LEASE_RENEW_INTERVAL_SECONDS=20.0
# 后台任务最大执行尝试次数
WORKER_MAX_ATTEMPTS=5
# 是否启用内嵌后台任务循环
WORKER_LOOP_ENABLED=true
# 任务重试退避的基础时间（秒）
WORKER_BACKOFF_BASE_SECONDS=2.0
# 任务重试退避的最长时间（秒）
WORKER_BACKOFF_MAX_SECONDS=300.0
# 任务重试退避的随机抖动比例
WORKER_BACKOFF_JITTER_RATIO=0.2
# 待核验任务再次执行前的延迟（秒）
WORKER_RECONCILE_DELAY_SECONDS=10.0
# 后台任务关闭时等待排空的宽限时间（秒）
WORKER_SHUTDOWN_GRACE_SECONDS=15.0
# 后台任务执行器心跳间隔（秒）
WORKER_HEARTBEAT_INTERVAL_SECONDS=30.0
# Optional atomic JSON heartbeat file for container HEALTHCHECK probes
# 供容器健康检查读取的后台任务执行器 JSON 心跳文件路径
# WORKER_HEARTBEAT_FILE=/tmp/mem-ai-worker-heartbeat.json
# Data retention (conversations & generations default to long-term indefinite retention)
# 会话及生成记录保留策略；当前支持 indefinite（长期保留）
CONVERSATION_RETENTION_POLICY=indefinite
# 任务执行尝试记录保留天数
JOB_ATTEMPT_RETENTION_DAYS=30
# 幂等记录保留时长（小时）
IDEMPOTENCY_RETENTION_HOURS=24
# 操作摘要保留天数
OPERATION_SUMMARY_RETENTION_DAYS=30
# 保留策略清理任务执行间隔（秒）
RETENTION_CLEANUP_INTERVAL_SECONDS=900
# 每批清理的记录数量上限
RETENTION_BATCH_SIZE=100
# 每次清理运行的最大批次数
RETENTION_MAX_BATCHES_PER_RUN=50
