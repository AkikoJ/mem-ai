# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_VERSION=0.1.0

# PostgreSQL (local Docker Compose default)
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=mem_ai
POSTGRES_USER=mem_ai
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
# Optional host bind-mount path for Docker Compose PostgreSQL data;
# leave unset to use the default named volume `postgres_data`.
# POSTGRES_DATA_DIR=/path/to/postgres-data

# Database pool and timeouts
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10.0
DB_CONNECT_TIMEOUT_SECONDS=5.0
DB_STATEMENT_TIMEOUT_MS=10000
DB_HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# Outbound HTTP client timeouts
HTTP_CONNECT_TIMEOUT_SECONDS=5.0
HTTP_READ_TIMEOUT_SECONDS=30.0
HTTP_WRITE_TIMEOUT_SECONDS=10.0
HTTP_POOL_TIMEOUT_SECONDS=5.0

# Authentication (`development` | `jwt_hs256` | `trusted_gateway`)
# Production strictly rejects `development`.
AUTH_MODE=development
AUTH_DEV_ISSUER=https://dev.mem-ai.local
AUTH_DEV_SUBJECT=dev-user
# AUTH_TRUSTED_ISSUERS=["https://idp.example.com"]
# AUTH_TRUSTED_AUDIENCE=mem-ai-api
# AUTH_JWT_HS256_SECRET=replace-with-at-least-32-char-secret
# AUTH_JWT_LEEWAY_SECONDS=30
# AUTH_TRUSTED_PROXIES=["10.0.0.0/8"]
# AUTH_GATEWAY_SHARED_SECRET=replace-with-at-least-32-char-secret
# AUTH_GATEWAY_SECRET_HEADER=X-Gateway-Auth
# AUTH_GATEWAY_ISSUER_HEADER=X-Auth-Issuer
# AUTH_GATEWAY_SUBJECT_HEADER=X-Auth-Subject
# AUTH_GATEWAY_ACTOR_HEADER=X-Auth-Actor-Id
# AUTH_GATEWAY_PERMISSIONS_HEADER=X-Auth-Permissions

# Memory provider (`disabled` | `memos`)
# Keep MEMOS_API_KEY strictly server-side; never commit real keys.
MEMORY_PROVIDER_MODE=disabled
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
# MEMOS_API_KEY=replace-with-server-side-memos-api-key
MEMOS_REQUEST_TIMEOUT_SECONDS=15.0
MEMOS_LIST_PAGE_SIZE=100
MEMOS_LIST_MAX_ITEMS=1000
MEMORY_LIST_SNAPSHOT_TTL_SECONDS=600
MEMORY_INFLIGHT_SETTLE_TIMEOUT=60.0
MEMORY_CLEAR_COMPENSATION_DELAY_SECONDS=30.0
# Optional independent append-only JSONL deletion audit archive path (outside DB backups)
# DELETION_AUDIT_ARCHIVE_PATH=/var/lib/mem-ai/deletion-audit.jsonl

# Model provider (`disabled` | `openai_compatible`) and chat budgets
# Keep OPENAI_COMPAT_API_KEY strictly server-side; never commit real keys.
MODEL_PROVIDER_MODE=disabled
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=replace-with-server-side-model-api-key
OPENAI_COMPAT_REQUEST_TIMEOUT_SECONDS=60.0
# MODEL_DEFAULT_ID=gpt-4o-mini
# MODEL_FORCED_ID=
MODEL_ALLOW_REQUEST_OVERRIDE=false
MODEL_SYNC_ON_STARTUP=true
# MODEL_REGISTRY_ENTRIES=[{"model_id":"gpt-4o-mini","provider_id":"openai_compatible","upstream_model":"gpt-4o-mini","display_name":"GPT-4o Mini","enabled":true,"supports_streaming":true}]
CHAT_GENERATION_TIMEOUT_SECONDS=60.0
CHAT_STREAM_TIMEOUT_SECONDS=120.0
CHAT_STREAM_HEARTBEAT_INTERVAL_SECONDS=15.0
CHAT_HISTORY_MESSAGE_LIMIT=20
CHAT_LEASE_TTL_SECONDS=60
CHAT_LEASE_RENEW_INTERVAL_SECONDS=20.0
CHAT_MEMORY_RECALL_TIMEOUT_SECONDS=5.0
CHAT_MEMORY_MIN_RELEVANCE=0.5
CHAT_MEMORY_MAX_ITEMS=10
CHAT_MEMORY_CONTEXT_MAX_CHARS=2000
CHAT_PROMPT_MAX_CHARS=24000

# Background worker and durable job budgets
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_CLAIM_BATCH_SIZE=10
WORKER_LEASE_TTL_SECONDS=60
WORKER_LEASE_RENEW_INTERVAL_SECONDS=20.0
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_SECONDS=2.0
WORKER_BACKOFF_MAX_SECONDS=300.0
WORKER_BACKOFF_JITTER_RATIO=0.2
WORKER_RECONCILE_DELAY_SECONDS=10.0
WORKER_SHUTDOWN_GRACE_SECONDS=15.0
JOB_ATTEMPT_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_HOURS=24
